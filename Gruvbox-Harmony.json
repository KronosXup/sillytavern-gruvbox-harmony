232%2074%203%202%20-10%2054%20-30%20114%20-29%2087%20-40%20109%20-52%20104%20-8%20-3%20-137%0A-43%20-286%20-89%20-1635%20-505%20-2962%20-653%20-3527%20-392%20-121%2056%20-151%20108%20-253%20434%20-76%0A241%20-126%20350%20-200%20432%20-85%2094%20-224%20155%20-462%20205%20-186%2039%20-343%2050%20-620%2043%20-408%0A-10%20-818%20-70%20-1351%20-198%20-446%20-107%20-1102%20-308%20-1576%20-482%20-38%20-15%20-70%20-25%20-71%0A-24%20-2%201%2036%2034%2084%2072%20135%20109%20613%20521%20862%20743%20223%20200%20225%20201%20272%20202%20102%201%0A193%2026%20453%20125%2039%2015%20192%2062%20340%20105%20299%2086%20391%20119%20448%20156%2096%2063%20104%20170%2018%0A232%20l-40%2029%20242%2098%20c438%20177%20591%20244%20684%20297%20161%2092%20223%20157%20223%20233%200%2054%20-29%0A98%20-82%20124%20-36%2017%20-63%2021%20-149%2021%20l-104%200%2047%2030%20c171%20107%20641%20352%201468%20763%0A894%20444%201040%20538%201040%20665%200%20147%20-126%20169%20-474%2082%20-66%20-16%20-121%20-28%20-122%20-27%0A-1%201%20108%2070%20244%20152%20880%20535%201846%201157%202147%201383%20144%20108%20311%20258%20830%20746%2088%0A83%20315%20292%20504%20465%20827%20756%201398%201319%201827%201801%20623%20700%20886%201173%20810%201455%0A-20%2076%20-49%20126%20-101%20174%20-117%20108%20-316%20151%20-560%20120z%20m313%20-245%20c108%20-30%20142%0A-93%20117%20-219%20-88%20-457%20-956%20-1449%20-2495%20-2850%20-242%20-220%20-385%20-352%20-671%20-621%0A-396%20-372%20-597%20-551%20-714%20-639%20-429%20-322%20-2190%20-1430%20-2940%20-1850%20-140%20-78%0A-210%20-135%20-221%20-179%20-7%20-28%2037%20-120%2061%20-130%2031%20-12%20120%20-6%20200%2013%2044%2011%20186%0A49%20315%2085%20129%2037%20244%2069%20255%2072%2011%202%20-322%20-168%20-740%20-379%20-946%20-477%20-1132%0A-577%20-1343%20-719%20-157%20-107%20-205%20-173%20-188%20-261%207%20-36%2056%20-90%2096%20-105%2015%20-6%2057%0A-13%2095%20-17%20l68%20-8%20-129%20-52%20c-71%20-29%20-237%20-97%20-369%20-150%20-398%20-162%20-511%20-221%0A-561%20-294%20-31%20-45%20-32%20-110%20-4%20-157%2020%20-31%2020%20-33%203%20-38%20-10%20-3%20-91%20-26%20-181%0A-51%20-90%20-25%20-201%20-58%20-247%20-75%20-47%20-16%20-85%20-27%20-85%20-26%200%202%20107%20102%20237%20222%0A304%20280%201169%201087%201698%201584%201543%201450%201895%201774%203475%203195%201223%201100%201388%0A1252%201656%201519%20194%20194%20246%20254%20426%20486%20113%20146%20202%20266%20199%20268%20-16%206%20-510%0A-207%20-611%20-264%20-655%20-373%20-2079%20-1518%20-3895%20-3133%20-1263%20-1124%20-1798%20-1618%0A-3128%20-2890%20l-119%20-115%2040%2080%20c22%2043%2081%20183%20132%20309%2090%20224%20203%20494%20218%20520%204%0A8%207%20-32%207%20-88%201%20-138%2019%20-175%2099%20-200%20l55%20-18%2041%2027%20c81%2054%20200%20266%20499%20889%0A168%20350%20281%20571%20281%20554%200%20-4%20-11%20-60%20-25%20-125%20-15%20-66%20-29%20-167%20-32%20-225%20l-6%0A-106%2031%20-46%20c29%20-41%2037%20-46%2082%20-52%2069%20-10%20120%2021%20194%20118%20111%20145%20216%20342%20516%0A962%20114%20237%20230%20458%20237%20452%202%20-2%20-12%20-67%20-31%20-144%20-83%20-338%20-80%20-459%2011%20-513%0A86%20-51%20206%206%20253%20120%20133%20324%20366%20749%20603%201105%20752%201128%201917%202175%203339%203003%0A849%20494%201786%20900%202508%201086%20346%2089%20544%20109%20688%2070z%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E\") !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n  background-size: contain !important;\n  transition: transform 0.3s ease, filter 0.2s ease !important;\n  transform-origin: 50% 80% !important;\n}\n\n#send_but {\n  transition: filter 0.2s ease, opacity 0.2s ease;\n  filter: drop-shadow(0 0 2px rgba(142, 192, 124, 0.2));\n}\n\n#send_but:hover::before {\n  animation: quill-write 1.5s ease-in-out infinite !important;\n}\n\n#send_but:hover {\n  filter: drop-shadow(0 0 8px rgba(142, 192, 124, 0.6));\n}\n\n#send_but:active {\n  filter: drop-shadow(0 0 4px rgba(142, 192, 124, 0.3));\n  opacity: 0.8;\n}\n\n@keyframes quill-write {\n  0%, 100% { transform: rotate(-8deg) translateX(-2px); }\n  50% { transform: rotate(5deg) translateX(2px); }\n}\n\n/* ============================================================\n * Gruvbox Dark + HarmonyOS Sans SC\n * ============================================================ */\n\n@import url('https://cdn.jsdelivr.net/npm/@lobehub/webfont-harmony-sans-sc@1.0.0/css/index.css');\n\n:root {\n  --font-scale: 0.95;\n  --font-mono: 'JetBrains Mono', 'HarmonyOS Sans SC', 'Cascadia Code', 'Consolas', monospace;\n}\n\n/* 全局字体（排除图标和代码高亮） */\nbody, .mes_text, p, div, span:not([class*=\"hljs\"]):not(.fa):not([class*=\"fa-\"]),\ninput, textarea, button, select, option, label,\nh1, h2, h3, h4, h5, h6,\n#chat, .mes, .mes_block, .mesText, .mesAliasAndName, .mesIDDisplay,\n#send_form, .drawer, .drawer-content, .panel {\n  font-family: 'HarmonyOS Sans SC', sans-serif !important;\n}\n\n/* 代码块字体 */\npre, code, .hljs, .mes_text pre, .mes_text code,\n.mes_text .hljs span, .mes_text pre span, .mes_text code span {\n  font-family: var(--font-mono) !important;\n}\n\n/* 背景 */\nbody {\n  background-color: #1d2021 !important;\n}\n\nbody::after {\n  content: \"\";\n  position: fixed;\n  top: 0; left: 0; right: 0; bottom: 0;\n  background-image:\n    repeating-linear-gradient(45deg, transparent, transparent 35px, rgba(142, 192, 124, 0.008) 35px, rgba(142, 192, 124, 0.008) 70px),\n    repeating-linear-gradient(-45deg, transparent, transparent 35px, rgba(131, 165, 152, 0.008) 35px, rgba(131, 165, 152, 0.008) 70px);\n  pointer-events: none;\n  z-index: 0;\n}\n\n#chat {\n  background-color: transparent !important;\n}\n\n/* 消息气泡 */\n.mes {\n  background-color: rgba(40, 40, 40, 0) !important;\n  backdrop-filter: none !important;\n}\n\n.mes_block {\n  flex: 1 1 auto !important;\n  display: flex !important;\n}\n\n.mesAvatarWrapper {\n  flex-shrink: 0;\n}\n\n/* 楼层号/时间/token 换行不挤占正文 */\n.mesIDDisplay, .mes_timer, .tokenCounterDisplay {\n  display: block !important;\n}\n\n/* 引号 <q> */\n.mes_text q {\n  font-weight: 500;\n  color: #83a598;\n  border-left: 3px solid #83a598;\n  background-color: rgba(131, 165, 152, 0.1);\n  padding-left: 8px;\n  padding-right: 4px;\n  margin-left: 4px;\n  border-radius: 0 4px 4px 0;\n  display: inline-block;\n}\n\n/* 代码块 */\n.mes_text pre {\n  background-color: #1d2021 !important;\n  border: 1px solid #504945;\n  border-radius: 4px;\n}\n\n.mes_text code {\n  background-color: #1d2021 !important;\n}\n\n/* 输入栏 */\n#send_form {\n  background-color: #3c3836 !important;\n  border: 1px solid #504945 !important;\n  border-radius: 4px;\n}\n\ntextarea, input[type=\"text\"], input[type=\"password\"] {\n  border: 1px solid #504945 !important;\n  background-color: #1d2021 !important;\n  color: #ebdbb2 !important;\n}\n\n/* 面板/抽屉边框 */\n.drawer, .drawer-content, #left-nav-panel, #right-nav-panel,\n#character_popup, #dialogue_popup, .panel {\n  border: 1px solid #504945 !important;\n  background-color: #282828 !important;\n}\n\n/* 分割线 */\nhr, .mes hr, .drawer-content hr {\n  border-color: #504945 !important;\n}\n\n/* 提示词管理器 */\n.prompt_manager_template_entry, .prompt_manager_entry {\n  border: 1px solid #504945 !important;\n}\n\n/* 底部按钮发光（aqua） */\n#send_form .fa-solid, #send_form a {\n  transition: filter 0.2s ease;\n}\n\n#send_form .fa-solid:hover, #send_form a:hover {\n  filter: drop-shadow(0 0 6px rgba(142, 192, 124, 0.5));\n}\n\n/* 图标通用发光 */\n.interactable:hover {\n  filter: drop-shadow(0 0 4px rgba(142, 192, 124, 0.3));\n}\n\n/* 角色列表分割线 */\n#rm_char_list hr {\n  border-color: #504945 !important;\n}\n\n\n/* ---- 头像不挤压正文 ---- */\n.mes {\n  padding-left: 0 !important;\n}\n\n.mesAvatarWrapper {\n  width: 70px;\n  min-width: 70px;\n  flex-shrink: 0;\n  margin-right: 10px;\n}\n\n.mes_block {\n  width: calc(100% - 80px) !important;\n  min-width: 0 !important;\n}\n\n/* ---- 消息背景色强制覆盖 ---- */\n.mes, .last_mes .mes {\n  background-color: #282828 !important;\n}\n\n/* ---- 背景遮罩透明度 ---- */\n#chat::before {\n  content: \"\";\n  position: absolute;\n  top: 0; left: 0; right: 0; bottom: 0;\n  background-color: rgba(29, 32, 33, 0.92);\n  pointer-events: none;\n  z-index: -1;\n}\n\n/* ---- 聊天区背景 ---- */\n#chat {\n  background-color: rgba(29, 32, 33, 0.75) !important;\n}\n\n/* ---- 全局字体排除 i 和 fa-* ---- */\ni, .fa, [class*=\"fa-\"] {\n  font-family: 'Font Awesome 6 Free', 'Font Awesome 6 Brands', sans-serif !important;\n}\n\n/* ---- 消息文字颜色强制 ---- */\n.mes_text, .mes_text p, .mes_text div {\n  color: #ebdbb2 !important;\n}\n\n/* ---- 消息名字颜色 ---- */\n.mes AliasAndName, .mes_alias, .ch_name {\n  color: #a89984 !important;\n}\n\n/* 推理块 */\n.reasoning_header, .mes_reasoning_header {\n  padding-right: 28px;\n}\n",
